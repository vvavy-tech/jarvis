# JARVIS runtime
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional integrations - none are required for JARVIS to start.
# Each service reports "available but not connected" until configured.
# Do NOT commit real credentials to this repository.

# --- Spotify (Web API control; local desktop media control works without these) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Gmail (read-only) ---
# Path to a Google API OAuth client secrets JSON file.
GMAIL_OAUTH_CREDENTIALS=
# Optional: path to the stored Gmail access token file.
GMAIL_TOKEN_PATH=

# --- Google Calendar (read-only) ---
# Path to a Google API OAuth client secrets JSON file (can be the same as Gmail).
GOOGLE_OAUTH_CREDENTIALS=
# Optional: path to the stored Calendar access token file.
CALENDAR_TOKEN_PATH=

# --- Meta / Facebook Ads (read-only analytics) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Autonomous maintenance (default 60 minutes) ---
JARVIS_MAINTENANCE_INTERVAL_MINUTES=60

# --- Safe automatic memory (OPT-IN, default OFF) ---
# Off by default for voice-first stability. When enabled (true/1/on/yes),
# JARVIS records durable facts from normal accepted conversation in the
# background: preferences, decisions, project choices. The explicit
# "remember ..." / "onthoud dat ..." path is unchanged and always works.
# Set to true ONLY after live voice testing shows no regressions.
JARVIS_AUTO_MEMORY=false